# 1. نظام التشغيل المصغر (خفيف وسريع)
FROM python:3.11-slim

# 2. تحديد مجلد العمل داخل الحاوية
WORKDIR /app

# 3. نسخ ملف المتطلبات أولاً (للاستفادة من ذاكرة التخزين المؤقت لـ Docker)
COPY requirements.txt .

# 4. تثبيت المكتبات (نحن نثق الآن أن ملفك مكتمل)
RUN pip install --no-cache-dir -r requirements.txt

# 5. نسخ باقي ملفات المشروع إلى الحاوية
COPY . .

# 6. فتح المنفذ رقم 8000 لكي يستطيع العالم الخارجي التحدث مع الـ API
EXPOSE 8000

# 7. أمر تشغيل السيرفر (تماماً كما فعلت في الـ Terminal)
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]